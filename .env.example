# ─────────────────────────────────────────────────────────────
# FSSE Handbook — local configuration
# Copy this file to `.env` and change values if a port is taken:
#   cp .env.example .env
# All ports are intentionally NOT the usual defaults, to avoid
# clashing with other apps on your machine.
# ─────────────────────────────────────────────────────────────

# Handbook app
HANDBOOK_PORT=5391            # npm run dev      (default Vite: 5173)
HANDBOOK_PREVIEW_PORT=4391    # npm run preview  (default Vite: 4173)

# Exercises & projects
FLASK_PORT=5091               # default Flask: 5000 (also used by macOS AirPlay)
FASTAPI_PORT=8091             # default FastAPI/uvicorn: 8000
NEXT_PORT=3091                # default Next.js: 3000
POSTGRES_PORT=5491            # default PostgreSQL: 5432
REDIS_PORT=6391               # default Redis: 6379
LANGFUSE_PORT=3191            # default Langfuse: 3000

# AI (Module 7 & future AI review)
OLLAMA_URL=http://localhost:11434

# Future: AI review in the handbook (keep false until implemented)
VITE_AI_REVIEW_ENABLED=false
