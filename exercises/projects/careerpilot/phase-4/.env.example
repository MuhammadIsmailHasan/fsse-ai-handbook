# CareerPilot web (Next.js) — copy to .env.local for development. Never commit real values.
# Base URL of the Phase 2 Flask API (without /api/v1)
API_URL=http://localhost:5091
# 32+ random characters: openssl rand -base64 32
SESSION_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3091
# Only set to false for plain-http local testing (the acceptance tests do this)
COOKIE_SECURE=true
