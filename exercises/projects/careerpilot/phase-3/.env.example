# Same secret as the Phase 2 API (JWT_SECRET_KEY there), so one login works for both services.
JWT_SECRET=change-me-to-a-long-random-string-of-32-chars-or-more
# Optional (stretch goal): a real LLM provider. The service must work without it.
# LLM_API_KEY=
# Phase 3 listens on a non-default port so it does not clash with other projects.
PORT=5093
