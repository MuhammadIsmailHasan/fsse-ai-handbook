# Copy to .env.local (git-ignored). Server-only values have no prefix.
API_URL=http://localhost:5091
API_TOKEN=change-me
APP_ENV=development

# NEXT_PUBLIC_ values are inlined into the browser bundle at build time — never put secrets here.
NEXT_PUBLIC_API_URL=http://localhost:5091
NEXT_PUBLIC_APP_NAME=CareerPilot
